# Copy to .env.local for local dev. Names only: never commit real values.

# Supabase project URL. Public (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Public (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key; acts as service_role and skips RLS. Server only.
SUPABASE_SECRET_KEY=

# Clerk publishable key for sign-in UI. Public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key for backend calls. Server only.
CLERK_SECRET_KEY=
# Clerk webhook signing secret (billing + user events). Server only.
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI API key for chat + embeddings. Server only.
OPENAI_API_KEY=

# Arcjet key for rate limits and prompt-injection checks. Server only.
ARCJET_KEY=

# PostHog project key. Public.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host. Public.
NEXT_PUBLIC_POSTHOG_HOST=

# Base URL of this deployment. Public.
NEXT_PUBLIC_APP_URL=
# Widget key for the landing page's live widget, read at request time per environment. Server only.
LANDING_WIDGET_KEY=
